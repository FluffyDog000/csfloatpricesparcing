# ============================================================================
# CSFloat Sales Tracker — environment configuration
# Copy this file to ".env" and fill in the values. NEVER commit the real .env.
# ============================================================================

# ----------------------------------------------------------------------------
# Authentication for the undocumented "Latest Sales" endpoint.
#
# The "Latest Sales" tab is served by CSFloat's internal frontend endpoint,
# not the public documented API. To call it you must replay the same request
# your browser makes. Open the item page, DevTools (F12) -> Network ->
# Fetch/XHR, click the "Latest Sales" tab, find the request to
# ".../history/.../sales", right-click -> Copy -> "Copy as cURL", and read the
# request headers from it. See README.md for step-by-step screenshots guide.
#
# You typically need EITHER the session cookie OR a bearer/authorization token.
# Provide whichever your browser actually sends. If both are present, provide
# both. Leave the unused one blank.
# ----------------------------------------------------------------------------

# Full raw Cookie header value copied from the request (everything after
# "Cookie: "). Example: "cf_clearance=...; session=...; __cf_bm=..."
CSFLOAT_COOKIE=

# Authorization header value if the request uses a bearer token instead of
# (or in addition to) a cookie. Paste the value only (no "Authorization:"
# prefix). Example: "Bearer eyJ..."  or a bare token string.
CSFLOAT_AUTHORIZATION=

# ----------------------------------------------------------------------------
# Optional: official public CSFloat API key.
# Only used for GET /api/v1/listings (active listings), which is useful for
# sanity-checking but USELESS for sales history. Safe to leave blank.
# ----------------------------------------------------------------------------
CSFLOAT_API_KEY=

# ----------------------------------------------------------------------------
# Paths (optional — sensible defaults are used if unset)
# ----------------------------------------------------------------------------
# Path to the SQLite database file.
CSFLOAT_DB_PATH=data/csfloat_sales.db

# Path to the log file (rotated automatically).
CSFLOAT_LOG_PATH=logs/collector.log

# Directory where the first raw API response per item is dumped for you to
# inspect / send back so field mappings can be verified.
CSFLOAT_RAW_DUMP_DIR=raw_dumps

# ----------------------------------------------------------------------------
# Polling behaviour (optional — overrides values in config.yaml)
# ----------------------------------------------------------------------------
# Default poll interval bounds per item, in minutes. A random value in
# [MIN, MAX] is chosen for each poll (jitter) to avoid a fixed cadence.
CSFLOAT_POLL_MIN_MINUTES=15
CSFLOAT_POLL_MAX_MINUTES=30
